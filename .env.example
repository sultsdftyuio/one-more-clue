# Copy to .env.local for local development, or add these in Vercel →
# Project → Settings → Environment Variables. Every feature stays switched
# off until its variables are present, so the site works with none of them.

# --- Domain -----------------------------------------------------------------
# The canonical address. Until you own a domain, Vercel's address is used.
# If this is a www address, the bare domain redirects to it.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# --- Waitlist (Upstash Redis) -------------------------------------------------
# Vercel → Storage → Create → Upstash for Redis → connect to this project:
# it adds these automatically. Without them, local dev writes to .data/waitlist.json.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Accounts (Supabase) --------------------------------------------------------
# supabase.com → your project → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional, to share sessions across subdomains:
# NEXT_PUBLIC_SUPABASE_COOKIE_DOMAIN=.your-domain.com

# --- Payments (Dodo Payments) ---------------------------------------------------
# Needs Supabase too (purchases are tied to accounts). Use test_mode until launch.
DODO_PAYMENTS_ENV=test_mode
DODO_PAYMENTS_API_KEY=
# Dodo → Developer → Webhooks → endpoint https://<your-site>/api/webhooks/dodo
DODO_PAYMENTS_WEBHOOK_KEY=
# One Dodo product (one-time payment) per paid case, see src/data/catalog.ts
DODO_PRODUCT_CASE_002=
DODO_PRODUCT_CASE_003=
DODO_PRODUCT_CASE_004=
# The Season 1 bundle (Cases 002-004 together)
DODO_PRODUCT_BUNDLE_SEASON_1=

# --- The game -------------------------------------------------------------------
# Rooms live in the same Upstash Redis as the waitlist (required in production).
# Previews and local dev always have the game; the live site keeps the
# "get early access" flow until this is 1 (redeploy after changing it).
GAME_OPEN=
# Test bots are on in local dev and previews. Set to 1 to allow them elsewhere.
GAME_TEST_BOTS=
# Local dev keeps rooms in .data/rooms; set to "redis" to use Redis locally.
ROOMS_STORE=

# --- Voice chat and instant updates (LiveKit) -------------------------------------
# cloud.livekit.io → your project → Settings → Keys. Without these, rooms poll
# for updates every 2 seconds and remote rooms have text chat only.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Legal pages --------------------------------------------------------------------
# Shown on /privacy and /terms. Both pages say "Draft" until LEGAL_REVIEWED=1.
NEXT_PUBLIC_CONTACT_EMAIL=
LEGAL_REVIEWED=
